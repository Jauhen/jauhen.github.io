"d"],["pg",""],["pc","dq"],["pc","d"],["pc","d"],["pc","c"],["pg",""],["pc","d"],["pc","d"],["pc","dk"],["pc","h"],["pg",""],["pc","dj"],["pc","h"],["pc","c"],["pc","h"],["pg",""],["pc","d"],["pc","h"],["pc","c"],["pc","c"],["pg",""],["hc","ca"],["at","and play the @CA, "],["pg",""],["lc","ca"],["pc","c"],["pc","c"],["pc","ca"],["pc","c"],["pg",""],["hs","nh"],["at","it will be too late to establish the Hearts. "],["pg",""],["ls","nh"],["hs","wc"],["hs","ec"],["at","When you try to do that you will find that you have too many quick losers in Clubs "],["pg",""],["ls","wc"],["ls","ec"],["hs","ws"],["at","and Spades. "],["pg",""],["ls","ws"],["up","12"],["hc","ca"],["at","You must keep the @CA to control that suit "],["pg",""],["lc","ca"],["hs","sd"],["at","and you must keep some Diamonds "],["pg",""],["ls","sd"],["hs","ws"],["at","to prevent the opponents from being able to take Spade tricks when they get the lead. "],["pg",""],["ls","ws"],["hs","sd"],["hs","nd"],["nt","\nYou should play enough of your Diamonds to eliminate all of the opponents' trumps. On this hand, after you draw trump, "],["pg",""],["ls","sd"],["ls","nd"],["hs","nh"],["hs","sh"],["at","take your losses early and play Hearts immediately while you still have control. "],["pg",""],["ls","nh"],["ls","sh"],["hs","wh"],["hs","eh"],["at","You must let the opponents in twice "],["pg",""],["ls","wh"],["ls","eh"],["hs","nh"],["at","to establish your Heart trick, so you must be prepared to handle whatever they lead back each time."],["",""]]}}