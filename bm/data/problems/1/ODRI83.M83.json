:[82,83,87,88,70,71,72,73,42,43,27,28,32],"raw":[3,202,4,203,6,1,203,8,1,11,203,10,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,35,82,83,87,88,70,71,72,73,42,43,27,28,32]}],"auctionColumns":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null]},"solution":{"header":{"dealer":"w","hands":{"S":{"S":"K3","H":"QJT98","D":"A32","C":"QT9"},"W":{"S":"QT987","H":"32","D":"KQJT","C":"32"},"N":{"S":"AJ2","H":"7654","D":"654","C":"AKJ"},"E":{"S":"654","H":"AK","D":"987","C":"87654"}},"bids":["4h","p","p","p"],"names":null},"ops":[["nt",""],["sk",""],["wt","s"],["ha","y"],["cb","0200"],["cg","010"],["cr","0200"],["hc","dk"],["at","\nWest leads the @DK against your contract of Four Hearts."],["pg",""],["lc","dk"],["pc","dk"],["hs","sh"],["nt","\nYou can afford three losers. You have two Heart losers, "],["pg",""],["ls","sh"],["hs","sd"],["at","two Diamond losers, "],["pg",""],["ls","sd"],["hs","sc"],["at","but no Club "],["pg",""],["ls","sc"],["hs","ss"],["at","or Spade losers. "],["pg",""],["ls","ss"],["hc","hak"],["at","You definitely will lose the @HA and @HK, "],["pg",""],["lc","hak"],["hs","sd"],["at","so you must concentrate on trying to eliminate one of your Diamond losers. You cannot trump one in the dummy and there are no immediate extra tricks on which you can discard one of your losers."],["pg",""],["ls","sd"],["hc","sj"],["nt","\nIn such a situation, you have to look hard to see if there is any possibility of eliminating your loser. The @SJ in dummy gives you a chance. "],["pg",""],["lc","sj"],["hc","sq"],["at","If West has the @SQ, you can take a finesse "],["pg",""],["lc","sq"],["hs","ns"],["at","and create an extra winner in dummy on which you can discard one of your losers."],["pg",""],["ls","ns"],["hc","da"],["nt","\nAfter winning the @DA, "],["pg",""],["lc","da"],["pc","d"],["pc","d"],["pc","da"],["pg",""],["hs","sh"],["hs","nh"],["at","can you afford to draw trump? No. You will have to lose the lead and the opponents will be able to take four fast tricks."],["pg",""],["ls","sh"],["ls","nh"],["hc","sk"],["nt","\nPlay the @SK first, "],["pg",""],["lc","sk"],["pc","sk"],["pc","s"],["pc","s"],["pc","s"],["pg",""],["hs","ss"],["at","the high card from the short side. "],["pg",""],["ls","ss"],["hc","s3"],["at","Now play the @S3 "],["pg",""],["lc","s3"],["pc","s3"],["hs","ws"],["at","and when West follows small, "],["pg",""],["ls","ws"],["pc","s"],["hc","sj"],["at","finesse the @SJ. "],["pg",""],["lc","sj"],["pc","sj"],["md","0,s6,,sq"],["hc","sq"],["at","Here you will have to hold your breath. If East has the @SQ, you will lose a Spade trick you hadn't originally counted on, "],["pg",""],["lc","sq"],["hs","eh"],["at","in addition to the two Heart tricks "],["pg",""],["ls","eh"],["hs","wd"],["at","and two Diamond tricks that must be lost. You will be defeated in your contract by two tricks."],["pg",""],["ls","wd"],["md","0,sq,,s6"],["hc","sq"],["nt","\nIf, however, West has the @SQ, "],["pg",""],["lc","sq"],["hs","sj"],["at","your @SJ "],["pg",""],["lc","sj"],["hs","es"],["at","will win. "],["pg",""],["ls","es"],["pc","s"],["pg",""],["hc","sa"],["at","The @SA can be played "],["pg",""],["lc","sa"],["pc","sa"],["pc","s"],["hs","sd"],["at","for a Diamond discard. "],["pg",""],["ls","sd"],["pc","d"],["pc","s"],["pg",""],["hs","sh"],["hs","nh"],["at","It is then safe to start drawing trump as you have only three losers left."],["pg",""],["ls","sh"],["ls","nh"],["hc","sq"],["nt","\nIs it worth taking the chance of going down two tricks instead of one while trying to make your contract? Certainly. The penalty for going down one extra trick is much less than the bonus you get for making your game contract. Besides, think of the excitement you'll have waiting to find out which opponent has the missing @SQ!"],["",""]]}}