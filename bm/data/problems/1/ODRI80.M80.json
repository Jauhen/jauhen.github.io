s"],["hs","sd"],["at","your loser. "],["pg",""],["ls","sd"],["hs","ss"],["hs","ns"],["at","You have nine trump cards "],["pg",""],["ls","ss"],["ls","ns"],["hs","ws"],["hs","es"],["at","and the opponents have only four. "],["pg",""],["md","0,s4,,h8"],["at","If they are divided 2-2, you can draw them and still have one left in dummy. "],["pg",""],["md","0,h8,,s4"],["at","What if they are distributed 3-1 "],["pg",""],["md","0,h7,,s5"],["at","or 4-0? "],["pg",""],["ls","ws"],["ls","es"],["hs","sd"],["nt","\nIf you play two rounds of trump and then stop to try and trump your loser, it will be too late. "],["pg",""],["ls","sd"],["hs","es"],["at","You have to lose Diamond tricks to make dummy void, and when you do this, one of the opponents may be unkind enough to lead a trump and remove dummy's last trump."],["pg",""],["md","0,s5,,h7"],["nt","\nSince you have to lose two Diamond tricks before you can trump your loser, you cannot afford to play even one round of trump. If you do so, the opponents might continue to lead trump "],["pg",""],["ls","es"],["hs","ed"],["at","each time they get the lead, "],["pg",""],["ls","ed"],["hs","ns"],["at","and again, you will not have a trump in dummy "],["pg",""],["ls","ns"],["hs","sd"],["at","when it comes time to trump your last Diamond."],["pg",""],["ls","sd"],["hc","ca"],["nt","\nInstead, delay drawing trump and take your losses early. Win the opening lead with dummy's @CA, "],["pg",""],["lc","ca"],["pc","ca"],["pc","c"],["pc","c"],["pg",""],["hc","ck"],["at","keeping the @CK in your hand as an entry. "],["pg",""],["lc","ck"],["hs","ed"],["at","Immediately give up a Diamond trick to the opponents. "],["pg",""],["ls","ed"],["pc","dq"],["pc","dk"],["pc","d"],["pc","d"],["pg",""],["hs","es"],["at","If they lead a trump, "],["pg",""],["ls","es"],["pc","s"],["hs","ss"],["at","you can win "],["pg",""],["ls","ss"],["pc","s"],["pc","s"],["pc","s"],["pg",""],["hs","ed"],["at","and give up another Diamond trick. "],["pg",""],["ls","ed"],["pc","d"],["pc","d"],["pc","d"],["pc","d"],["pg",""],["hs","es"],["at","They can lead another trump, but you will win the race. "],["pg",""],["ls","es"],["pc","s"],["hs","ss"],["nt","\nAfter winning the trump return, "],["pg",""],["ls","ss"],["pc","s"],["pc","d"],["pc","s"],["pg",""],["hs","sd"],["at","you can trump your remaining Diamond "],["pg",""],["ls","sd"],["pc","d"],["pc","d"],["hs","ns"],["at","in dummy. "],["pg",""],["ls","ns"],["pc","s"],["pc","d"],["pg",""],["hc","ck"],["at","Your @CK is an entry to your hand "],["pg",""],["lc","ck"],["hs","es"],["at","to draw any remaining trump."],["",""]]}}