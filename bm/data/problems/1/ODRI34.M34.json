200,200,200,200,200,200,200,200,200,200]},{"conds":[{"who":"W","type":"toLead","typeId":1,"args":[]},{"who":"W","type":"suitCount","typeId":3,"args":[4,3,0]}],"play":95,"west":[],"raw":[1,202,1,202,3,4,3,0,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,95,200,200,200,200,200,200,200,200,200,200,200,200,200]},{"conds":[{"who":"W","type":"toPlay","typeId":4,"args":[]},{"who":"N","type":"ledSuit","typeId":6,"args":[3]},{"who":"N","type":"isWinning","typeId":10,"args":[]},{"who":"W","type":"suitCount","typeId":3,"args":[3,2,1]},{"who":"S","type":"suitCount","typeId":3,"args":[3,2,1]},{"who":"S","type":"has","typeId":2,"args":[3,13]}],"play":75,"west":[88,89,64,74,50,51,52,53,28,29,30,31,32],"raw":[5,202,4,203,6,3,203,10,202,3,3,2,1,201,3,3,2,1,201,2,3,13,200,200,200,200,200,200,200,200,200,200,200,200,200,200,75,88,89,64,74,50,51,52,53,28,29,30,31,32]}],"auctionColumns":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null]},"solution":{"header":{"dealer":"w","hands":{"S":{"S":"K32","H":"A32","D":"K32","C":"A432"},"W":{"S":"QJT98","H":"KQJT","D":"54","C":"98"},"N":{"S":"A4","H":"654","D":"QJT98","C":"765"},"E":{"S":"765","H":"987","D":"A76","C":"KQJT"}},"bids":["1n","p","p","p"],"names":null},"ops":[["nt",""],["sk",""],["wt","s"],["ha","y"],["cb","0200"],["cg","010"],["cr","0200"],["hc","sq"],["at","\nWest leads the @SQ against your contract of One No Trump."],["pg",""],["lc","sq"],["pc","sq"],["hs","ss"],["hs","ns"],["nt","\nTo make your contract, you need seven tricks. You have two in Spades, "],["pg",""],["ls","ss"],["ls","ns"],["hs","sh"],["at","one in Hearts, "],["pg",""],["ls","sh"],["hs","sc"],["at","and one in Clubs, for a total of four tricks. You need three more. "],["pg",""],["ls","sc"],["hs","nd"],["hs","sd"],["at","The Diamond suit offers a chance to promote four winners "],["pg",""],["ls","sd"],["ls","nd"],["hc","da"],["at","by driving out the @DA."],["pg",""],["lc","da"],["hs","ns"],["nt","\nThe opponents are going to try to eliminate your entries "],["pg",""],["ls","ns"],["hs","nd"],["at","so that you have difficulty taking your Diamond tricks. If you are careful, though, their attempts will not work. If you are careless, you may wonder where your tricks went when the hand is over."],["pg",""],["ls","nd"],["hc","sa"],["nt","Let's see what happens if you play the hand without paying attention to the fourth part of the plan - how do I put it all together? Suppose you take the first trick in dummy with the @SA. "],["pg",""],["lc","sa"],["pc","sa"],["pc","s"],["pc","s"],["pg",""],["hs","nd"],["hs","sd"],["at","Next you play the Diamonds because you want to get extra tricks from this suit. "],["pg",""],["ls","sd"],["at","You play a Diamond "],["pg",""],["ls","nd"],["pc","d"],["pc","d"],["hc","dk"],["at","to your @DK "],["pg",""],["lc","dk"],["pc","dk"],["pc","d"],["pg",""],["hs","sd"],["at","(high card from the short side) and a Diamond "],["pg",""],["ls","sd"],["pc","d"],["pc","d"],["hc","dq"],["at","back to dummy's @DQ. "],["pg",""],["lc","dq"],["pc","dq"],["pc","d"],["pg",""],["hc","dj"],["at","You continue by playing the @DJ, "],["pg",""],["lc","dj"],["pc","dj"],["hc","da"],["at","then East, who has been holding up, finally takes his @DA. "],["pg",""],["lc","da"],["pc","da"],["pc","d"],["pc","c"],["pg",""],["hs","es"],["nt","\nEast leads another Spade, "],["pg",""],["ls","es"],["pc","s"],["hs","ws"],["at","returning his partner's suit. "],["pg",""],["ls","ws"],["hc","sk"],["at","You win the @SK in your hand. "],["pg",""],["lc","sk"],["pc","sk"],["pc","s"],["pc","s"],["pg",""],["hc","sakdkq"],["at","You have taken the @SA and @SK and the @DK and @DQ, a total of four tricks. "],["pg",""],["lc","sakdkq"],["hc","haca"],["at","You have the @CA and @HA which brings your total to six tricks. "],["pg",""],["lc","haca"],["hs","nd"],["at","There are two good Diamonds in the dummy, but they are stranded. You will end up one trick short of making your contract."],["pg",""],["ls","nd"],["up","19"],["hc","sa"],["nt","Now, let's see what happens if you take the time to make a complete plan. After the opening lead of the @SQ, pause for a moment before deciding whether to win the trick with dummy's @SA "],["pg",""],["lc","sa"],["hc","sk"],["at","or your @SK. "],["pg",""],["lc","sk"],["hs","nd"],["at","You plan to establish the Diamond suit "],["pg",""],["ls","nd"],["hc","da"],["at","and if the defense holds up the @DA, "],["pg",""],["lc","da"],["hs","nd"],["at","you will need an entry to dummy to reach your winners. "],["pg",""],["ls","nd"],["hc","sk"],["at","This reasoning makes it clear that you should win the first trick with the @SK in your hand. "],["pg",""],["lc","sk"],["pc","s"],["pc","s"],["pc","sk"],["pg",""],["hs","nd"],["hs","sd"],["nt","\nNow you can work on Diamonds. "],["pg",""],["ls","sd"],["ls","nd"],["pc","dk"],["pc","d"],["pc","d"],["pc","d"],["pg",""],["pc","d"],["pc","d"],["pc","dq"],["pc","d"],["pg",""],["pc","d"],["hc","da"],["at","Even if the opponents hold up the @DA, "],["pg",""],["lc","da"],["pc","da"],["pc","d"],["pc","c"],["pg",""],["hs","ns"],["at","you will have the entry you need "],["pg",""],["ls","ns"],["hs","nd"],["at","to take dummy's winners. "],["pg",""],["ls","nd"],["hs","ss"],["hs","ns"],["at","You will wind up making an overtrick with two Spade tricks, "],["pg",""],["ls","ss"],["ls","ns"],["hs","sh"],["at","one Heart trick, "],["pg",""],["ls","sh"],["hs","nd"],["hs","sd"],["at","four Diamond tricks, "],["pg",""],["ls","nd"],["ls","sd"],["hs","sc"],["at","and one Club trick - quite a difference!"],["",""]]}}