04,3,1,3,0,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,135,200,200,200,200,200,200,200,200,200,200,200,200,200]}],"auctionColumns":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null]},"solution":{"header":{"dealer":"w","hands":{"S":{"S":"AQT7","H":"J","D":"A5432","C":"Q32"},"W":{"S":"632","H":"KQT98","D":"87","C":"KT9"},"N":{"S":"KJ98","H":"A5432","D":"6","C":"J54"},"E":{"S":"54","H":"76","D":"KQJT9","C":"A876"}},"bids":["4s","p","p","p"],"names":null},"ops":[["nt",""],["sk",""],["wt","s"],["ha","y"],["cb","0200"],["cg","010"],["cr","0200"],["hc","hk"],["at","\nWest leads the @HK against your contract of Four Spades."],["pg",""],["lc","hk"],["pc","hk"],["hs","ss"],["nt","\nYou can afford three losers. You have no losers in Spades "],["pg",""],["ls","ss"],["hs","sh"],["at","and Hearts, "],["pg",""],["ls","sh"],["hs","sd"],["at","but you have four potential Diamond losers "],["pg",""],["ls","sd"],["hs","sc"],["at","and three potential Club losers. That's seven losers. You will have to eliminate four of them. "],["pg",""],["ls","sc"],["hs","nd"],["at","Fortunately, dummy has a singleton Diamond. "],["pg",""],["ls","nd"],["hs","sd"],["at","You can plan to trump all of your Diamond losers "],["pg",""],["ls","sd"],["hs","ns"],["at","in dummy."],["pg",""],["nt","\nCan you draw trump? You are going to need all of dummy's trump "],["pg",""],["ls","ns"],["hs","sd"],["at","to ruff your Diamond losers, so you cannot afford to play even one round of trump. "],["pg",""],["ls","sd"],["hc","ha"],["at","You start by winning the @HA, "],["pg",""],["lc","ha"],["pc","ha"],["pc","h"],["pc","h"],["pg",""],["hs","nd"],["at","playing dummy's small Diamond "],["pg",""],["ls","nd"],["pc","d"],["pc","d"],["hc","da"],["at","to your @DA, "],["pg",""],["lc","da"],["pc","da"],["pc","d"],["pg",""],["hs","sd"],["at","then leading another Diamond "],["pg",""],["ls","sd"],["pc","d"],["pc","d"],["hs","ns"],["at","and trumping it in dummy. "],["pg",""],["ls","ns"],["pc","s"],["pc","d"],["pg",""],["hs","sd"],["at","What are you going to use as an entry back to your hand so that you can lead another Diamond?"],["pg",""],["ls","sd"],["hs","nh"],["nt","\nThe way you can get back to your hand is by leading one of dummy's Hearts "],["pg",""],["ls","nh"],["pc","h"],["pc","h"],["hs","ss"],["at","and trumping it in your hand. "],["pg",""],["ls","ss"],["pc","s"],["pc","h"],["pg",""],["hs","sd"],["at","Continuing in this fashion, you lead a Diamond from your hand "],["pg",""],["ls","sd"],["pc","d"],["pc","c"],["hs","ns"],["at","and trump it in the dummy, "],["pg",""],["ls","ns"],["pc","s"],["pc","d"],["pg",""],["hs","nh"],["at","followed by a Heart from the dummy, "],["pg",""],["ls","nh"],["pc","h"],["pc","c"],["hs","ss"],["at","trumped in your hand. "],["pg",""],["ls","ss"],["pc","s"],["pc","h"],["pg",""],["hc","hada"],["at","You can take the first ten tricks by continuing in this fashion, the @HA and @DA, "],["pg",""],["lc","hada"],["hs","ss"],["hs","ns"],["at","and all eight of your trump."],["pg",""],["ls","ss"],["ls","ns"],["nt","\nOn this deal you trumped, or ruffed, losers in both hands, crossing back and forth. Playing a hand in this manner is called a cross-ruff. A hand such as this is not too common, but it shows that you don't always get the kiddies off the street."],["",""]]}}