4,3,1,3,0,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,135,200,200,200,200,200,200,200,200,200,200,200,200,200]}],"auctionColumns":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null]},"solution":{"header":{"dealer":"w","hands":{"S":{"S":"32","H":"K432","D":"KQJ","C":"KJT9"},"W":{"S":"87","H":"QJT98","D":"765","C":"876"},"N":{"S":"A654","H":"A5","D":"432","C":"AQ32"},"E":{"S":"KQJT9","H":"76","D":"AT98","C":"54"}},"bids":["3n","p","p","p"],"names":null},"ops":[["nt",""],["sk",""],["wt","s"],["ha","y"],["cb","0200"],["cg","010"],["cr","0200"],["hc","hq"],["at","\nWest leads the @HQ against your contract of Three No Trump."],["pg",""],["lc","hq"],["pc","hq"],["hs","ns"],["nt","\nYour objective is to take nine tricks. You have one sure Spade trick, "],["pg",""],["ls","ns"],["hs","sh"],["hs","nh"],["at","two Heart tricks, "],["pg",""],["ls","sh"],["ls","nh"],["hs","sc"],["hs","nc"],["at","and four Club tricks. "],["pg",""],["ls","sc"],["ls","nc"],["hs","sd"],["at","You need to develop two extra tricks. These can be easily established in the Diamond suit "],["pg",""],["ls","sd"],["hc","da"],["at","by driving out the @DA. "],["pg",""],["lc","da"],["hs","nd"],["hs","sd"],["at","There will be no entry problems in Diamonds "],["pg",""],["ls","sd"],["at","since the number of cards in the dummy "],["pg",""],["ls","nd"],["hs","sd"],["at","is equal to the number of cards in your hand."],["pg",""],["nt","\nWhen you ask yourself \"How do I put it all together?\", you have to decide whether you should take your sure tricks first and then establish Diamonds, or whether you should start with the Diamonds. This is when you have to consider taking your losses early."],["pg",""],["ls","sd"],["hc","ha"],["nt","\nSuppose you decide to take your sure tricks first. You win the @HA, "],["pg",""],["lc","ha"],["pc","ha"],["pc","h"],["pc","h"],["pg",""],["hc","sa"],["at","play the @SA, "],["pg",""],["lc","sa"],["pc","sa"],["pc","s"],["pc","s"],["pc","s"],["pg",""],["hc","hk"],["at","@HK, "],["pg",""],["lc","hk"],["pc","h"],["pc","h"],["pc","hk"],["pc","h"],["pg",""],["hs","sc"],["hs","nc"],["at","and four Club tricks. "],["pg",""],["ls","sc"],["ls","nc"],["pc","c"],["pc","c"],["pc","ca"],["pc","c"],["pg",""],["pc","cq"],["pc","c"],["pc","c"],["pc","c"],["pg",""],["pc","c"],["pc","d"],["pc","ck"],["pc","c"],["pg",""],["pc","cj"],["pc","d"],["pc","c"],["pc","d"],["pg",""],["hc","dk"],["at","Then you lead the @DK "],["pg",""],["lc","dk"],["pc","dk"],["pc","d"],["pc","d"],["hc","da"],["at","to drive out the opponents' @DA. "],["pg",""],["lc","da"],["pc","da"],["pg",""],["hs","sd"],["nt","\nWhat will happen? The opponents will be delighted! They will not help you get your Diamond winners "],["pg",""],["ls","sd"],["hs","ed"],["at","by leading back a Diamond. "],["pg",""],["hs","wd"],["at","They will have been busy discarding their little Diamonds "],["pg",""],["ls","wd"],["ls","ed"],["hs","wh"],["at","and keeping winners in Hearts "],["pg",""],["ls","wh"],["hs","es"],["at","and Spades which have been established for them. You have done the opponents' work for them and created too many quick losers for yourself."],["pg",""],["ls","es"],["up","28"],["hs","sd"],["nt","\nThe key is timing - start to promote the Diamonds while you still have control of the hand. Having control of the hand means not having too many quick losers when the opponents get the lead. By retaining your winners in the other suits, you avoid losing control when the opponents get in."],["pg",""],["hs","nd"],["nt","\nOn this hand, after winning the opening lead, immediately lead the Diamonds "],["pg",""],["ls","sd"],["ls","nd"],["pc","d"],["pc","d"],["pc","dk"],["pc","d"],["pg",""],["pc","dq"],["pc","d"],["pc","d"],["pc","da"],["pg",""],["hs","sd"],["at","and establish the two extra tricks that you need. "],["pg",""],["ls","sd"],["hc","da"],["at","Once the opponents have played the @DA, there is nothing they can do to stop you from making your contract. Whatever suit they lead, you can win (you have control) and take nine tricks."],["",""]]}}